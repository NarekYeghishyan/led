# Copy to /opt/led-computers/.env, chmod 600. Generate secrets with: openssl rand -hex 32
POSTGRES_PASSWORD=
JWT_SECRET=
# The store agent's config.ini [api] key must be the same value
SYNC_API_KEY=
# First admin user, created only when the admin_users table is empty
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Customer e-mails (password reset codes). Leave SMTP_HOST empty until the mailbox is ready.
# Example Gmail/Workspace: SMTP_HOST=smtp.gmail.com SMTP_PORT=465 SMTP_SECURE=true SMTP_USER=noreply@led.am SMTP_PASS=<app password>
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
SMTP_FROM="LED Computers <noreply@led.am>"
# 1 = write reset codes to the API log while mail/SMS is not configured (testing only)
MAIL_DEV_LOG=
# AI photo finder (admin -> product -> "Find photo (AI)"). Gemini key from aistudio.google.com.
GEMINI_API_KEY=
# optional, default gemini-flash-latest (falls back to gemini-3.5-flash, gemini-flash-lite-latest when busy)
GEMINI_MODEL=
# Web image search — set at least one, otherwise only pasted page/image links work:
#  Google Custom Search JSON API (100 free queries/day): key + search engine id with "Image search" and "Search the entire web" on
GOOGLE_CSE_KEY=
GOOGLE_CSE_CX=
#  Brave Search API (images endpoint)
BRAVE_SEARCH_KEY=
#  1 = Gemini Google Search grounding finds product pages (needs billing on the Gemini key; free tier returns 429)
GEMINI_SEARCH=
TAG=latest
